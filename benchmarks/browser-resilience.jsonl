{"id": "browser-res-003", "suite": "browser-resilience", "category": "dual_gate_verification", "description": "TIGER-AI-Lab Pattern: Dual-Gate Visual SSIM and Semantic Accessibility DOM verification", "assertions": [{"type": "visual_ssim_threshold", "min_ssim": 0.98}, {"type": "semantic_a11y_gate", "require_aria_labels": true, "require_semantic_tags": ["header", "main", "nav", "button"]}]}
