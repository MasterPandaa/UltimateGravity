{"id": "browser-res-001", "suite": "browser-resilience", "category": "action_taxonomy_read", "description": "Halluminate Pattern (READ): High-resilience structured data extraction from dynamic DOM", "assertions": [{"type": "selector_strategy", "strategy": "prefer_role_or_test_id"}, {"type": "resilience", "handle_stale_element": true}, {"type": "forbidden_patterns", "patterns": ["sleep(", "time.sleep("]}]}
